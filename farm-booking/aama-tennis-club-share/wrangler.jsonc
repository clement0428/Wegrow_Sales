{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wegrow-farm-booking-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wegrow-farm-booking-prod",
      "database_id": "4f40a0e0-e5bb-4de0-93ad-91ad3b32dfc7",
      "migrations_dir": "d1/migrations"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_LIFF_ID": "",
    "DEV_FAKE_LOGIN": "1"
  },
  "env": {
    "production": {
      "name": "wegrow-farm-booking",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wegrow-farm-booking-prod",
          "database_id": "4f40a0e0-e5bb-4de0-93ad-91ad3b32dfc7",
          "migrations_dir": "d1/migrations"
        }
      ],
      "vars": {
        "NEXT_PUBLIC_LIFF_ID": ""
      }
    }
  }
}
