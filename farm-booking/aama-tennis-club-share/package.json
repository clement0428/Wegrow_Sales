{
  "name": "wegrow-farm-line-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/sync-build-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:farm": "vitest run tests/farm",
    "test:watch": "vitest",
    "cf:dev": "wrangler d1 migrations apply DB --local",
    "cf:seed": "wrangler d1 execute DB --local --file d1/migrations/0002_seed_dev.sql",
    "preview": "cross-env BUILD_TARGET_ENV=preview opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "cross-env BUILD_TARGET_ENV=production opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "postdeploy": "node scripts/verify-prod-liff.mjs",
    "deploy:dev": "cross-env BUILD_TARGET_ENV=preview opennextjs-cloudflare build && opennextjs-cloudflare deploy --env=\"\"",
    "migrate:prod": "wrangler d1 migrations apply DB --remote --env production",
    "migrate:dev": "wrangler d1 migrations apply DB --remote",
    "migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@line/liff": "^2.31.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsonc-parser": "^3.3.1",
    "puppeteer": "^25.11.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
